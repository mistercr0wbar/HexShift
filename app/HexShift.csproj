<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Windows app: a WinForms window hosting WebView2, with HexShift.html and the
    WebView2 SDK assemblies embedded so the build output is a single HexShift.exe.
    Targets .NET Framework 4.8, which every Windows 10 and 11 install already has.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>5</LangVersion>
    <AssemblyName>HexShift</AssemblyName>
    <RootNamespace>HexShift</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>3.0.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <Product>Hex Shift</Product>
    <Authors>mistercr0wbar</Authors>
    <Copyright>MIT License</Copyright>
    <Description>Recolour one part of an emoji and keep its shading.</Description>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- compile against the SDK only; the DLLs are embedded below, not copied next to the exe -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="[1.0.4258.31]" GeneratePathProperty="true" ExcludeAssets="build;native;contentFiles;runtime" />
    <!-- lets the net48 build run on any machine with the .NET SDK, including the GitHub runner -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="[1.0.3]" PrivateAssets="all" />
    <!-- Ed25519 checks for update feeds and installers. No dependencies; embedded below like WebView2. -->
    <PackageReference Include="NetSparkleUpdater.Chaos.NaCl" Version="[0.9.4]" GeneratePathProperty="true" ExcludeAssets="runtime" />
    <!-- JavaScriptSerializer reads the update feed. Part of the framework, so nothing extra ships. -->
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\HexShift.html" LogicalName="HexShift.html" />
    <EmbeddedResource Include="$(PkgNetSparkleUpdater_Chaos_NaCl)\lib\net462\Chaos.NaCl.dll" LogicalName="Chaos.NaCl.dll" />
    <EmbeddedResource Include="update-public-key.txt" LogicalName="UpdatePublicKey.txt" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.Core.dll" LogicalName="Microsoft.Web.WebView2.Core.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\lib\net462\Microsoft.Web.WebView2.WinForms.dll" LogicalName="Microsoft.Web.WebView2.WinForms.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" LogicalName="WebView2Loader.x64.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x86\native\WebView2Loader.dll" LogicalName="WebView2Loader.x86.dll" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-arm64\native\WebView2Loader.dll" LogicalName="WebView2Loader.arm64.dll" />
  </ItemGroup>

</Project>
